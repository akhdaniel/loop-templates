{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "scripts/run_tests.sh*": "allow",
      "flutter test*": "allow",
      "flutter analyze*": "allow",
      "flutter pub get": "allow",
      "dart format*": "allow",
      "dart run build_runner*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "scripts/lock_tests.sh*": "deny",
      "rm -rf*": "deny",
      "git push*": "deny",
      "flutter pub add*": "deny",
      "dart pub add*": "deny",
      "flutter pub publish*": "deny",
      "dart pub publish*": "deny",
      "shorebird *": "deny",
      "fastlane *": "deny",
      "firebase deploy*": "deny",
      "*update-goldens*": "deny"
    }
  }
}
