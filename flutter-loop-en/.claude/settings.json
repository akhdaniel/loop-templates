{
  "permissions": {
    "allow": [
      "Read",
      "Edit(lib/**)",
      "Edit(PROGRESS.md)",
      "Bash(scripts/run_tests.sh:*)",
      "Bash(flutter test:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter pub get)",
      "Bash(dart format:*)",
      "Bash(dart run build_runner:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Edit(test/**)",
      "Write(test/**)",
      "Edit(integration_test/**)",
      "Write(integration_test/**)",
      "Edit(.tests.lock)",
      "Write(.tests.lock)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(pubspec.yaml)",
      "Edit(analysis_options.yaml)",
      "Edit(.env.test)",
      "Read(.env.test)",
      "Bash(scripts/lock_tests.sh:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(flutter pub add:*)",
      "Bash(dart pub add:*)",
      "Bash(flutter pub publish:*)",
      "Bash(dart pub publish:*)",
      "Bash(shorebird:*)",
      "Bash(fastlane:*)",
      "Bash(firebase deploy:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/block-dangerous.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/stop-gate.sh" }
        ]
      }
    ]
  }
}
