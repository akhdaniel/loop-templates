# Copy to .env.test and adjust for your machine.
# How to run Flutter and Dart (e.g. "fvm flutter" / "fvm dart" when you use FVM):
FLUTTER_BIN=flutter
DART_BIN=dart
# Minimum line coverage of the feature's own code by its locked tests (0 = off).
# Keeps the agent from adding untested code outside the spec.
COVERAGE_MIN=80
# Passed to tests as --dart-define=API_BASE_URL=... Must NEVER be production
# (the judge refuses "prod"). Leave empty if the app has no API.
API_BASE_URL=http://localhost:3000
# Optional E2E: run integration_test/<feature>/ after the widget tests pass.
# Needs a booted simulator/emulator or a connected device.
RUN_E2E=0
DEVICE_ID=
