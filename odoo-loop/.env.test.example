# Salin jadi .env.test lalu sesuaikan path di komputermu.
# Perintah untuk menjalankan Odoo (boleh pakai python dari venv):
ODOO_BIN="$HOME/odoo18/venv/bin/python $HOME/odoo18/odoo/odoo-bin"
# Folder addons bawaan Odoo (source code Odoo 18):
ODOO_ADDONS_PATH="$HOME/odoo18/odoo/addons"
# Folder bin venv yang berisi flake8 dan pylint (kosongkan kalau sudah di PATH):
VENV_BIN="$HOME/odoo18/venv/bin"
# Koneksi PostgreSQL (user harus boleh CREATE/DROP DATABASE)
PGHOST=localhost
PGPORT=5432
PGUSER=odoo
PGPASSWORD=odoo
# Nama DB test, WAJIB mengandung kata "test"
TEST_DB=db_test
# Port HTTP saat test, beda dengan Odoo dev-mu yang jalan di 8069
TEST_HTTP_PORT=8169
