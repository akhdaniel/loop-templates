# Copy to .env.test and adjust for your machine.
# How to run the project's local binaries (tsc, eslint, jest):
#   npm: "npx --no-install"   pnpm: "pnpm exec"   yarn: "yarn"   bun: "bunx"
PKG_EXEC="npx --no-install"
# Minimum line coverage of the feature's own code by its locked tests (0 = off).
# Keeps the agent from adding untested code outside the spec.
COVERAGE_MIN=80
# API used by the app during tests. Must NEVER be production (the judge refuses "prod").
EXPO_PUBLIC_API_URL=http://localhost:3000
# Optional E2E: run Maestro flows in e2e/<feature>/ after Jest passes.
# Needs a booted simulator/emulator with the dev build installed.
RUN_E2E=0
MAESTRO_BIN=maestro
