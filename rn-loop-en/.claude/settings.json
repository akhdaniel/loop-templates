{
  "permissions": {
    "allow": [
      "Read",
      "Edit(src/**)",
      "Edit(app/**)",
      "Edit(PROGRESS.md)",
      "Bash(scripts/run_tests.sh:*)",
      "Bash(npx --no-install tsc:*)",
      "Bash(npx --no-install jest:*)",
      "Bash(npx --no-install eslint:*)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)"
    ],
    "deny": [
      "Edit(src/features/*/__tests__/**)",
      "Write(src/features/*/__tests__/**)",
      "Edit(e2e/**)",
      "Write(e2e/**)",
      "Edit(.tests.lock)",
      "Write(.tests.lock)",
      "Edit(scripts/**)",
      "Write(scripts/**)",
      "Edit(package.json)",
      "Edit(jest.config.js)",
      "Edit(tsconfig.json)",
      "Edit(eslint.config.js)",
      "Edit(android/**)",
      "Edit(ios/**)",
      "Edit(.env.test)",
      "Read(.env.test)",
      "Bash(scripts/lock_tests.sh:*)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(npm publish:*)",
      "Bash(eas:*)",
      "Bash(npx eas:*)",
      "Bash(npm install:*)",
      "Bash(npx expo install:*)",
      "Bash(yarn add:*)",
      "Bash(pnpm add:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/block-dangerous.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "bash .claude/hooks/stop-gate.sh" }
        ]
      }
    ]
  }
}
