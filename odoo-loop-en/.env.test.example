# Copy to .env.test and adjust the paths for your machine.
# Command that runs Odoo (may use the python from a venv):
ODOO_BIN="$HOME/odoo18/venv/bin/python $HOME/odoo18/odoo/odoo-bin"
# Odoo's built-in addons folder (Odoo 18 source code):
ODOO_ADDONS_PATH="$HOME/odoo18/odoo/addons"
# Venv bin folder that contains flake8 and pylint (leave empty if they are on PATH):
VENV_BIN="$HOME/odoo18/venv/bin"
# PostgreSQL connection (the user must be allowed to CREATE/DROP DATABASE)
PGHOST=localhost
PGPORT=5432
PGUSER=odoo
PGPASSWORD=odoo
# Test DB name, MUST contain the word "test"
TEST_DB=db_test
# HTTP port during tests, different from your dev Odoo running on 8069
TEST_HTTP_PORT=8169
