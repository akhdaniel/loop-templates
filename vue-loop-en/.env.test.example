# Copy to .env.test and adjust for your machine.
# How to run the project's local binaries (vue-tsc, eslint, vitest, playwright):
#   npm: "npx --no-install"   pnpm: "pnpm exec"   yarn: "yarn"   bun: "bunx"
PKG_EXEC="npx --no-install"
# Minimum line coverage of the feature's own code by its locked tests (0 = off).
# Needs @vitest/coverage-v8. Keeps the agent from adding untested code outside the spec.
COVERAGE_MIN=80
# API used by the app during tests. Must NEVER be production (the judge refuses "prod").
VITE_API_URL=http://localhost:3000
# Optional E2E: run Playwright specs in e2e/<feature>/ after Vitest passes.
# Needs @playwright/test and its browsers (npx playwright install).
RUN_E2E=0
