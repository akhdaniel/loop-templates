{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "scripts/run_tests.sh*": "allow",
      "npx --no-install vue-tsc*": "allow",
      "npx --no-install vitest run*": "allow",
      "npx --no-install eslint*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "scripts/lock_tests.sh*": "deny",
      "rm -rf*": "deny",
      "git push*": "deny",
      "npm publish*": "deny",
      "npm install*": "deny",
      "yarn add*": "deny",
      "pnpm add*": "deny",
      "*vercel*": "deny",
      "netlify deploy*": "deny",
      "firebase deploy*": "deny",
      "*wrangler*": "deny"
    }
  }
}
