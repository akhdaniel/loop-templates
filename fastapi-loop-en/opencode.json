{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "ask",
      "scripts/run_tests.sh*": "allow",
      ".venv/bin/pytest*": "allow",
      ".venv/bin/ruff*": "allow",
      ".venv/bin/mypy*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git add*": "allow",
      "git commit*": "allow",
      "scripts/lock_tests.sh*": "deny",
      "*export_openapi*": "deny",
      "rm -rf*": "deny",
      "git push*": "deny",
      "*pip install*": "deny",
      "uv add*": "deny",
      "fly deploy*": "deny",
      "railway up*": "deny",
      "docker push*": "deny",
      "alembic upgrade*": "deny"
    }
  }
}
