# Copy to .env.test and adjust for your machine.
# Folder with python, pytest, ruff, mypy, uvicorn (uv users: .venv/bin as well)
VENV_BIN=.venv/bin
# Test database. "sqlite://" = in-memory, a fresh one per test (fast, no setup).
# For PostgreSQL, the name MUST contain "test", e.g.
#   postgresql+psycopg://api:api@localhost:5432/api_test   (needs psycopg installed)
TEST_DATABASE_URL=sqlite://
# Minimum line coverage of the feature's code by its locked tests (0 = off).
# Keeps the agent from adding untested code outside the spec.
COVERAGE_MIN=85
# Port for scripts/serve_test.sh (the API that frontend E2E tests talk to)
E2E_PORT=8000
